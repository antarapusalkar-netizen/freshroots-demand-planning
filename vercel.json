{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/deepa",
      "destination": "/api/page?view=deepa"
    },
    {
      "source": "/deepa/",
      "destination": "/api/page?view=deepa"
    },
    {
      "source": "/deepa.html",
      "destination": "/api/page?view=deepa"
    }
  ],
  "crons": [
    {
      "path": "/api/run",
      "schedule": "30 2 * * 1,4"
    }
  ]
}
