# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
# Optional (step 4). With none set the app says "Zoho not connected".
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=in
# Shared password for the dashboard (any username works)
SITE_PASSWORD=
# Protects the scheduled run endpoint; Vercel Cron sends it automatically
CRON_SECRET=
